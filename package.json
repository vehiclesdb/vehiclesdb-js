{
  "name": "@vehiclesdb/client",
  "version": "0.1.0",
  "description": "Vehicle makes, models and canonical vehicle ids (kind/make/model) from the open VehiclesDB dataset. Zero dependencies, ESM + CJS, works offline against the published CC-BY data.",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "resolution.cjs",
    "index.mjs",
    "index.d.ts",
    "README.md",
    "CONTRACT.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "VehiclesDB",
  "homepage": "https://vehiclesdb.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vehiclesdb/vehiclesdb-js.git"
  },
  "bugs": {
    "url": "https://github.com/vehiclesdb/vehiclesdb-js/issues"
  },
  "keywords": [
    "vehicles",
    "cars",
    "car-makes",
    "car-models",
    "motorcycles",
    "automotive",
    "dataset",
    "open-data",
    "vehiclesdb"
  ],
  "scripts": {
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  }
}
